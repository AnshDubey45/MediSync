{
  "version": "triage-v1.2",
  "thresholds": {
    "critical": 80,
    "high": 60,
    "medium": 35
  },
  "keywords": {
    "critical": ["chest pain", "shortness of breath", "unconscious", "stroke", "heart attack", "bleeding heavily", "seizure", "can't breathe"],
    "high": ["fever", "severe pain", "headache", "vomiting", "dizzy", "asthma", "broken"],
    "medium": ["cough", "mild pain", "rash", "sprain", "sore throat", "fatigue", "nausea"]
  },
  "weights": {
    "severity": {
      "critical_keyword_match": 40,
      "high_keyword_match": 25,
      "medium_keyword_match": 10
    },
    "duration": {
      "sudden": 20,
      "recent": 10,
      "ongoing": 5
    },
    "age_factor": {
      "elderly_over_65": 15,
      "child_under_5": 10
    }
  }
}
